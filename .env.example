# Deployment/developer configuration, never entered by players.
# Production: GitHub Actions secret. Local development: ignored .env.local.
# One public read-only token or a comma-separated queue (active token first).
VITE_CESIUM_ION_KEY=
# Optional comma-separated public read-only tokens, in replacement order.
# Used only after an ion 401 authentication error; never to bypass quotas.
VITE_CESIUM_ION_FALLBACK_KEYS=
# Optional Photon-compatible search endpoint.
VITE_GEOCODING_URL=

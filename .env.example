# Deployment/developer configuration, never entered by players.
# Production: GitHub Actions secret. Local development: ignored .env.local.
VITE_CESIUM_ION_KEY=
# Optional site-owned browser key, restricted by HTTP referrer to the deployed
# domain. Enables synchronized Street View inside the game; players enter nothing.
VITE_GOOGLE_MAPS_KEY=
# Optional Photon-compatible search endpoint.
VITE_GEOCODING_URL=
